{
  "name": "greenquote",
  "version": "0.1.0",
  "private": true,
  "description": "GreenQuote India — Embedded Point-of-Sale Lending & PM Surya Ghar Subsidy Infrastructure for Clean Energy",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "start": "npm run start -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "test": "npm run test:e2e -w apps/web",
    "test:e2e": "npm run test:e2e -w apps/web",
    "pretypecheck": "npm run build -w @greenquote/shared",
    "typecheck": "npm run typecheck -w apps/web",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
