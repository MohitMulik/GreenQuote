# ==============================================================================
# GreenQuote Monorepo Environment Configuration Template
# ==============================================================================
# Copy this file to each relevant app directory or use with Docker Compose

# --- Node Environment ---
NODE_ENV=development
PORT=4000

# --- Core API (apps/api) ---
MONGO_URI=mongodb://localhost:27017/greenquote
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars_long
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_min_32_chars
CORS_ORIGIN=http://localhost:3000

# --- Web Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_APP_NAME=GreenQuote

# --- Security & Encryption (AES-256-GCM Vault) ---
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
